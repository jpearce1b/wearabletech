// WINDOW
// ===================================================

void settings() {
  size(1160, 760);
}


// ===================================================
// SETUP
// ===================================================

void setup() {

  frameRate(30);

  surface.setTitle(
    "WIKIPEDIA / LIVE DATA MONITOR"
  );

  println();
  println("==============================");
  println("AVAILABLE SERIAL PORTS");
  println("==============================");

  String[] ports = Serial.list();

  for (int i = 0; i < ports.length; i++) {
    println("[" + i + "] " + ports[i]);
  }

  println("==============================");
  println();

  if (UNO_PORT >= 0 &&
      UNO_PORT < ports.length) {

    try {

      uno = new Serial(
        this,
        ports[UNO_PORT],
        115200
      );

      serialStatus = "CONNECTED";

      println("Arduino connected:");
      println(ports[UNO_PORT]);

    } catch (Exception e) {

      serialStatus = "CONNECTION FAILED";

      println("Serial connection error:");
      println(e);
    }
  }

  for (int i = 0; i < 64; i++) {
    ledColours[i] = color(0);
  }

  textFont(
    createFont("Monospaced", 14)
  );

  println("Wikipedia monitor starting...");
}


// ===================================================
// MAIN LOOP
// ===================================================

void draw() {

  background(9, 14, 24);

  // Poll Wikipedia every 10 seconds
  if (millis() - lastPoll >= POLL_INTERVAL) {

    lastPoll = millis();

    pollWikipedia();
  }

  // Update matrix colours
  updateLEDColours();

  // Send RGB frames to Arduino
  if (uno != null &&
      millis() - lastFrame >= FRAME_INTERVAL) {

    lastFrame = millis();

    sendMatrixFrame();
  }

  drawDashboard();
}


// ===================================================
// WIKIPEDIA HTTP REQUEST
// FIX FOR PROCESSING LOADJSONOBJECT ERROR
// ===================================================

JSONObject loadWikipediaData(String urlString) {

  HttpURLConnection connection = null;

  try {

    URL url = new URL(urlString);

    connection =
      (HttpURLConnection) url.openConnection();

    connection.setRequestMethod("GET");

    // Wikimedia requests a descriptive User-Agent.
    connection.setRequestProperty(
      "User-Agent",
      "WikipediaLEDWorkshop/1.0 " +
      "(https://github.com/jpearce1b)"
    );

    connection.setRequestProperty(
      "Accept",
      "application/json"
    );

    connection.setConnectTimeout(10000);
    connection.setReadTimeout(10000);

    int responseCode =
      connection.getResponseCode();

    println(
      "Wikipedia HTTP: " + responseCode
    );

    if (responseCode != 200) {

      println(
        "Wikipedia API returned HTTP " +
        responseCode
      );

      return null;
    }

    BufferedReader reader =
      new BufferedReader(
        new InputStreamReader(
          connection.getInputStream(),
          "UTF-8"
        )
      );

    StringBuilder result =
      new StringBuilder();

    String line;

    while (
      (line = reader.readLine()) != null
    ) {

      result.append(line);
    }

    reader.close();

    return parseJSONObject(
      result.toString()
    );

  } catch (Exception e) {

    println(
      "Wikipedia connection error: " + e
    );

    return null;

  } finally {

    if (connection != null) {
      connection.disconnect();
    }
  }
}


// ===================================================
// POLL WIKIPEDIA
// ===================================================

void pollWikipedia() {

  try {

    JSONObject response =
      loadWikipediaData(apiURL);

    if (response == null) {

      apiStatus = "CONNECTION ERROR";

      return;
    }

    JSONObject query =
      response.getJSONObject("query");

    JSONArray edits =
      query.getJSONArray("recentchanges");

    int newCount = 0;

    ArrayList<EditEvent> pending =
      new ArrayList<EditEvent>();


    for (int i = 0; i < edits.size(); i++) {

      JSONObject e =
        edits.getJSONObject(i);

      int id =
        e.getInt("rcid");

      String title =
        e.getString("title");

      int oldSize =
        e.getInt("oldlen", 0);

      int newSize =
        e.getInt("newlen", 0);

      int change =
        abs(newSize - oldSize);


      if (!seenIDs.contains(id)) {

        seenIDs.add(id);

        if (!firstPoll) {

          pending.add(
            new EditEvent(
              title,
              change
            )
          );

          newCount++;
        }
      }
    }


    // Keep memory usage bounded
    if (seenIDs.size() > 5000) {

      seenIDs.clear();
      firstPoll = true;
    }


    // Oldest edits first
    Collections.reverse(pending);

    for (EditEvent event : pending) {

      registerEdit(event);
    }


    // Update activity history
    for (int i = 0;
         i < history.length - 1;
         i++) {

      history[i] =
        history[i + 1];
    }

    history[history.length - 1] =
      newCount;


    apiStatus = "CONNECTED";

    firstPoll = false;


    println(
      "Wikipedia poll: " +
      newCount +
      " new edits"
    );

  } catch (Exception e) {

    apiStatus = "API ERROR";

    println(
      "Wikipedia parsing error: " + e
    );
  }
}


// ===================================================
// REGISTER WIKIPEDIA EDIT
// ===================================================

void registerEdit(EditEvent event) {

  totalEdits++;

  color waveColor;


  // SMALL EDIT
  if (event.bytes < 50) {

    smallEdits++;

    waveColor =
      color(40, 210, 255);

  }

  // MEDIUM EDIT
  else if (event.bytes < 500) {

    mediumEdits++;

    waveColor =
      color(190, 75, 255);

  }

  // LARGE EDIT
  else {

    largeEdits++;

    waveColor =
      color(255, 150, 35);

  }


  waves.add(
    new Wave(
      random(0, 8),
      random(0, 8),
      waveColor
    )
  );


  recentEdits.add(
    0,
    event
  );


  if (recentEdits.size() > 10) {

    recentEdits.remove(
      recentEdits.size() - 1
    );
  }


  if (waves.size() > 120) {

    waves.remove(0);
  }
}


// ===================================================
// UPDATE LED MATRIX COLOURS
// ===================================================

void updateLEDColours() {

  // Dark background
  for (int i = 0; i < 64; i++) {

    ledColours[i] =
      color(0, 2, 5);
  }


  for (int w = waves.size() - 1;
       w >= 0;
       w--) {

    Wave wave =
      waves.get(w);


    float age =
      (millis() - wave.startTime) /
      3000.0;


    if (age >= 1.0) {

      waves.remove(w);

      continue;
    }


    float radius =
      age * 11.0;

    float fade =
      1.0 - age;


    for (int y = 0; y < GRID; y++) {

      for (int x = 0; x < GRID; x++) {

        float distance =
          dist(
            x,
            y,
            wave.x,
            wave.y
          );


        float ring =
          abs(distance - radius);


        // Soft expanding ring
        float intensity =
          exp(
            -ring * ring * 1.5
          ) * fade;


        // Bright centre flash
        intensity +=
          exp(
            -distance * distance * 1.3
          ) *
          pow(
            1.0 - age,
            7.0
          ) *
          0.65;


        int index =
          y * GRID + x;


        color previous =
          ledColours[index];


        float redValue =
          min(
            255,
            red(previous) +
            red(wave.c) * intensity
          );


        float greenValue =
          min(
            255,
            green(previous) +
            green(wave.c) * intensity
          );


        float blueValue =
          min(
            255,
            blue(previous) +
            blue(wave.c) * intensity
          );


        ledColours[index] =
          color(
            redValue,
            greenValue,
            blueValue
          );
      }
    }
  }
}


// ===================================================
// SEND RGB DATA TO ARDUINO
// ===================================================

void sendMatrixFrame() {

  StringBuilder frame =
    new StringBuilder(385);


  for (int i = 0; i < 64; i++) {

    color c =
      ledColours[i];


    frame.append(
      hex(
        int(red(c)),
        2
      )
    );

    frame.append(
      hex(
        int(green(c)),
        2
      )
    );

    frame.append(
      hex(
        int(blue(c)),
        2
      )
    );
  }


  frame.append('\n');


  try {

    uno.write(
      frame.toString()
    );

  } catch (Exception e) {

    serialStatus =
      "SEND FAILED";

    println(
      "Serial send error: " + e
    );

    uno = null;
  }
}


