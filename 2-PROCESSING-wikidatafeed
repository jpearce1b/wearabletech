  fill(accent);
  textSize(35);

  text(
    value,
    x + 20,
    y + 80
  );
}


// ===================================================
// ACTIVITY GRAPH
// ===================================================

void drawHistoryGraph() {

  int maximum = 1;


  for (int n : history) {

    maximum =
      max(maximum, n);
  }


  float graphX = 65;
  float graphY = 425;
  float graphW = 670;
  float graphH = 155;

  float barWidth =
    graphW / history.length;


  noStroke();


  for (int i = 0;
       i < history.length;
       i++) {

    float h =
      map(
        history[i],
        0,
        maximum,
        0,
        graphH
      );


    fill(50, 190, 210);


    rect(
      graphX + i * barWidth,
      graphY + graphH - h,
      max(2, barWidth - 3),
      h
    );
  }
}


// ===================================================
// MINI 8x8 MATRIX PREVIEW
// ===================================================

void drawMiniMatrix(
  int x,
  int y,
  int cell
) {

  noStroke();


  for (int row = 0;
       row < 8;
       row++) {

    for (int col = 0;
         col < 8;
         col++) {

      fill(
        ledColours[row * 8 + col]
      );


      rect(
        x + col * cell,
        y + row * cell,
        cell - 2,
        cell - 2,
        2
      );
    }
  }
}


// ===================================================
// WAVE CLASS
// ===================================================

class Wave {

  float x;
  float y;

  color c;

  int startTime;


  Wave(
    float px,
    float py,
    color pc
  ) {

    x = px;
    y = py;

    c = pc;

    startTime = millis();
  }
}


// ===================================================
// EDIT EVENT CLASS
// ===================================================

class EditEvent {

  String title;

  int bytes;


  EditEvent(
    String t,
    int b
  ) {

    title = t;
    bytes = b;
  }
}
