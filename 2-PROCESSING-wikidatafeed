// ===================================================
// WIKIPEDIA SETTINGS
// ===================================================

String apiURL =
  "https://en.wikipedia.org/w/api.php?" +
  "action=query&list=recentchanges" +
  "&rctype=edit%7Cnew" +
  "&rcnamespace=0" +
  "&rcprop=ids%7Ctitle%7Csizes" +
  "&rclimit=100" +
  "&format=json&formatversion=2";

String apiStatus = "WAITING";

ArrayList<EditEvent> recentEdits =
  new ArrayList<EditEvent>();

HashSet<Integer> seenIDs =
  new HashSet<Integer>();

int totalEdits = 0;
int smallEdits = 0;
int mediumEdits = 0;
int largeEdits = 0;

int[] history = new int[48];

int lastPoll = -10000;
int lastFrame = 0;

final int POLL_INTERVAL = 10000;
final int FRAME_INTERVAL = 67;

boolean firstPoll = true;


