
#include <Wire.h>
#include <SparkFun_TMP117.h>
#include <WiFi.h>
#include <WiFiUdp.h>

// ==========================================
// NANO ESP32 - TEMPERATURE + TOUCH + WIFI
//
// TMP117 temperature sensor
// Capacitive touch on A0
// Sends data via UDP to Processing
// ==========================================

TMP117 sensor;

// Capacitive touch
const int touchPin = A0;
const int touchThreshold = 45000;

bool lastTouch = false;

// WIFI SETTINGS
const char* ssid = "blahblahdeck";
const char* password = "electr0nic";

// MAC IP ADDRESS
// Change this if your Mac's IP changes
const char* macIP = "192.168.0.1";

// UDP port
const int udpPort = 5005;

WiFiUDP udp;

// Timing
unsigned long lastSend = 0;
const unsigned long sendInterval = 100;

// WiFi reconnect timing
unsigned long lastReconnect = 0;

void setup() {

  Serial.begin(115200);
  delay(1500);

  Wire.begin();

  Serial.println();
  Serial.println("==============================");
  Serial.println("NANO ESP32 - TEMP + TOUCH + WIFI");
  Serial.println("==============================");

  // TMP117
  if (sensor.begin()) {
    Serial.println("TMP117 detected!");
  } else {
    Serial.println("TMP117 not detected - check wiring");
  }

  Serial.println("Capacitive touch ready");

  // Connect to WiFi
  Serial.println();
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  // Wait up to 15 seconds
  unsigned long startAttempt = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - startAttempt < 15000) {

    delay(500);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("WIFI CONNECTED!");
    Serial.print("Nano IP: ");
    Serial.println(WiFi.localIP());

    Serial.print("Sending to Mac: ");
    Serial.print(macIP);
    Serial.print(":");
    Serial.println(udpPort);

    Serial.print("Signal strength: ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");

  } else {

    Serial.println("WiFi connection failed.");
    Serial.println("Will retry automatically.");

  }

  udp.begin(udpPort);

  Serial.println("==============================");
}

void loop() {

  // Check WiFi connection
  if (WiFi.status() != WL_CONNECTED) {

    if (millis() - lastReconnect > 5000) {

      lastReconnect = millis();

      Serial.println("WiFi disconnected - reconnecting...");
      WiFi.reconnect();
    }
  }

  // Read temperature
  float temperature = sensor.readTempC();

  // Read capacitive touch
  int touchValue = touchRead(touchPin);

  bool touching = touchValue > touchThreshold;

  // Original serial feedback
  Serial.print("Temperature: ");
  Serial.print(temperature, 2);

  Serial.print(" C | Touch: ");
  Serial.print(touchValue);

  if (touching && !lastTouch) {
    Serial.print(" *** TOUCH DETECTED ***");
  }

  Serial.println();

  lastTouch = touching;

  // Send via WiFi every 100ms
  if (millis() - lastSend >= sendInterval) {

    lastSend = millis();

    if (WiFi.status() == WL_CONNECTED) {

      // Format:
      // temperature,touchValue,touchState
      //
      // Example:
      // 24.35,61200,1

      String data = String(temperature, 2);
      data += ",";
      data += String(touchValue);
      data += ",";
      data += String(touching ? 1 : 0);

      udp.beginPacket(macIP, udpPort);
      udp.print(data);
      udp.endPacket();
    }
  }

  delay(100);
}
